     shm_write(&shm_name, bytes)?;
 
@@ -372,7 +378,8 @@ fn transmit_shm(bytes: &[u8], w: u32, h: u32, id: u32, is_tmux: bool) -> Result<
     data.push_str(start);
     write!(
         data,
-        "{escape}_Gq=2,i={id},a=T,U=1,f=32,t=s,s={w},v={h},m=0;"
+        "{escape}_Gq=2,i={id},a=T,U=1,f=32,t=s,s={w},v={h},c={},r={},m=0;",
+        size.width, size.height
     )
     .unwrap();
     base64_simd::STANDARD.encode_append(shm_name.as_bytes(), &mut data);
@@ -389,6 +396,10 @@ fn transmit_shm(bytes: &[u8], w: u32, h: u32, id: u32, is_tmux: bool) -> Result<
 /// Removing the placements when the unicode placeholder is no longer there is being handled
 /// automatically by kitty.
 ///
+/// The placement's size in cells (`c`/`r`) is given rather than left for the terminal to work
+/// out from the pixel size: iTerm2 draws nothing without it, and a terminal whose cell size
+/// differs from the one the image was scaled for would draw it at the wrong size.
+///
 /// With `compress`, the payload is deflated and the transmission says `o=z`.
 /// That is the payload's ENCODING and nothing else: compression happens before
 /// base64, `f=32` still names the format the terminal finds after inflating, and
@@ -400,7 +411,15 @@ fn transmit_shm(bytes: &[u8], w: u32, h: u32, id: u32, is_tmux: bool) -> Result<
 /// `compress` must only be set when the terminal answered the `o=z` capability
 /// probe: a terminal that cannot inflate refuses the transmission outright, and
 /// every placement naming the image then draws nothing at all.
-fn transmit_base64(bytes: &[u8], w: u32, h: u32, id: u32, is_tmux: bool, compress: bool) -> String {
+fn transmit_base64(
+    bytes: &[u8],
+    w: u32,
+    h: u32,
+    size: Size,
+    id: u32,
+    is_tmux: bool,
+    compress: bool,
+) -> String {
     let bytes: Cow<[u8]> = if compress {
         Cow::Owned(zlib(bytes))
     } else {
@@ -433,7 +452,12 @@ fn transmit_base64(bytes: &[u8], w: u32, h: u32, id: u32, is_tmux: bool, compres
         write!(data, "{escape}_Gq=2,").unwrap();
 
         if i == 0 {
-            write!(data, "i={id},a=T,U=1,f=32,{compression}t=d,s={w},v={h},").unwrap();
+            write!(
+                data,
+                "i={id},a=T,U=1,f=32,{compression}t=d,s={w},v={h},c={},r={},",
+                size.width, size.height
+            )
+            .unwrap();
         }
 
         // m=0 means over
@@ -937,6 +961,25 @@ mod tests {
         (params, bytes)
     }
 
+    /// The size in cells is given, not left to the terminal to infer from the
