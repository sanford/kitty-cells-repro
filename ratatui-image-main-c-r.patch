         let img = canvas();
         let raw = img.to_rgba8();
-        let first = super::transmit_shm(raw.as_raw(), img.width(), img.height(), 7, false)
-            .expect("this platform writes shared memory");
-        let second = super::transmit_shm(raw.as_raw(), img.width(), img.height(), 7, false)
-            .expect("this platform writes shared memory");
