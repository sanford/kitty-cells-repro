+            img.height(),
+            Size::new(8, 2),
+            7,
+            false,
+            false,
+        );
+        let (params, _) = reassemble(&seq);
+        assert!(params.contains("c=8,r=2"), "{params}");
+    }
+
     #[test]
     fn transmit_without_compression_is_the_raw_image() {
         let img = canvas();
@@ -945,6 +988,7 @@ mod tests {
